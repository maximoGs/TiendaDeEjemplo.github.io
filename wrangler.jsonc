{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiendadepaisanabebidas-github-io",
  "compatibility_date": "2026-08-26",
  "pages_build_output_dir": ".",
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      "*.zip",
      "*.md",
      "package.json",
      "package-lock.json",
      "bun.lockb",
      "bun.lock"
    ]
  },
  "observability": {
    "enabled": true
  }
}
